# =============================================================================
# PRODUCTION GUARDIAN — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------------------
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Secret key for signing (generate with: openssl rand -hex 32)
SECRET_KEY=change-me-to-a-random-secret-key

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
# PostgreSQL connection string
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://guardian:guardian@localhost:5432/production_guardian

# Sync URL for Alembic migrations
DATABASE_SYNC_URL=postgresql://guardian:guardian@localhost:5432/production_guardian

# -----------------------------------------------------------------------------
# GOOGLE AI / GEMINI
# -----------------------------------------------------------------------------
# Get your API key from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-google-ai-studio-api-key

# Gemini model to use
GEMINI_MODEL=gemini-1.5-pro

# Set to false to use AI Studio (direct API key, not Vertex AI)
GOOGLE_GENAI_USE_VERTEXAI=false

# Only needed if using Vertex AI instead of AI Studio:
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# -----------------------------------------------------------------------------
# GRAFANA CLOUD
# -----------------------------------------------------------------------------
# Your Grafana Cloud stack URL (e.g., https://yourstack.grafana.net)
GRAFANA_URL=https://yourstack.grafana.net

# Grafana Service Account Token
# Create at: Grafana Cloud → Your Stack → Administration → Service Accounts
# Required scopes: MetricsPublisher (for writing), Viewer (for reading via MCP)
GRAFANA_SERVICE_ACCOUNT_TOKEN=glsa_your_service_account_token

# Grafana Prometheus Remote Write endpoint
# Find at: Grafana Cloud → Your Stack → Details → Prometheus → Remote Write URL
GRAFANA_PROMETHEUS_REMOTE_WRITE_URL=https://prometheus-prod-XX-prod-XX-X.grafana.net/api/prom/push

# Prometheus Remote Write credentials
# Username: your numeric Grafana Cloud Prometheus user ID
# Password: your Grafana Cloud API token (with MetricsPublisher scope)
GRAFANA_PROMETHEUS_USER_ID=123456
GRAFANA_PROMETHEUS_API_KEY=glc_your_grafana_cloud_api_key

# Grafana Loki push endpoint (optional, for log ingestion)
GRAFANA_LOKI_URL=https://logs-prod-XX.grafana.net
GRAFANA_LOKI_USER_ID=123456

# -----------------------------------------------------------------------------
# GRAFANA MCP
# -----------------------------------------------------------------------------
# The Grafana MCP server.
# Option 1 (recommended for local dev): Run mcp-grafana binary locally
#   See: https://github.com/grafana/mcp-grafana
#   Start with: mcp-grafana --transport http --grafana-url $GRAFANA_URL --grafana-token $GRAFANA_SERVICE_ACCOUNT_TOKEN
#   Then set: GRAFANA_MCP_URL=http://localhost:3000 (the MCP server port, not Grafana itself)
#
# Option 2: Grafana Cloud hosted MCP
#   GRAFANA_MCP_URL=https://mcp.grafana.net
GRAFANA_MCP_URL=http://localhost:8080

# MCP server transport: "http" (streamable-http) or "stdio"
GRAFANA_MCP_TRANSPORT=http

# -----------------------------------------------------------------------------
# SIMULATOR
# -----------------------------------------------------------------------------
# How often the simulator pushes metrics to Grafana (seconds)
SIMULATOR_PUSH_INTERVAL_SECONDS=15

# Enable automatic scenario injection on startup (for demo)
SIMULATOR_AUTO_START=false

# Default scenario when demo mode is activated
SIMULATOR_DEFAULT_SCENARIO=STORAGE_SATURATION

# -----------------------------------------------------------------------------
# TELEMETRY
# -----------------------------------------------------------------------------
# Production being simulated
PRODUCTION_NAME=nightfall
PRODUCTION_ENVIRONMENT=stage-7
